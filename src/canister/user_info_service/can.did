type FollowerItem = record {
  caller_follows : bool;
  profile_picture_url : opt text;
  principal_id : principal;
};
type FollowersResponse = record {
  next_cursor : opt principal;
  followers : vec FollowerItem;
  total_count : nat64;
};
type FollowingResponse = record {
  next_cursor : opt principal;
  following : vec FollowerItem;
  total_count : nat64;
};
// NSFW information for content moderation
type NSFWInfo = record {
  is_nsfw : bool;
  csam_detected : bool;
  nsfw_gore : text;
  nsfw_ec : text;
};
// Profile picture data with NSFW info
type ProfilePictureData = record { url : text; nsfw_info : NSFWInfo };
type ProfileUpdateDetails = record {
  bio : opt text;
  website_url : opt text;
  profile_picture_url : opt text;
};
type ProfileUpdateDetailsV2 = record {
  bio : opt text;
  website_url : opt text;
  profile_picture : opt ProfilePictureData;
};
type Result = variant { Ok; Err : text };
type Result_1 = variant { Ok : FollowersResponse; Err : text };
type Result_10 = variant { Ok : text; Err : text };
type Result_2 = variant { Ok : FollowingResponse; Err : text };
type Result_3 = variant { Ok : UserProfileDetailsForFrontendV4; Err : text };
type Result_4 = variant { Ok : UserProfileDetailsForFrontendV3; Err : text };
type Result_5 = variant { Ok : UserProfileDetailsForFrontendV5; Err : text };
type Result_6 = variant { Ok : UserProfileDetailsForFrontendV6; Err : text };
type Result_7 = variant { Ok : UserProfileDetailsForFrontendV7; Err : text };
type Result_8 = variant { Ok : SessionType; Err : text };
type Result_9 = variant {
  Ok : vec UserProfileDetailsForFrontendV7;
  Err : text;
};
type SessionType = variant { AnonymousSession; RegisteredSession };
type SubscriptionPlan = variant { Pro : YralProSubscription; Free };
type UserAccountType = variant {
  MainAccount : record { bots : vec principal };
  BotAccount : record { owner : principal };
};
type UserInfoServiceInitArgs = record { version : text };
type UserProfileDetailsForFrontendV3 = record {
  profile_picture_url : opt text;
  principal_id : principal;
  profile_stats : UserProfileGlobalStats;
};
type UserProfileDetailsForFrontendV4 = record {
  bio : opt text;
  website_url : opt text;
  following_count : nat64;
  user_follows_caller : opt bool;
  profile_picture_url : opt text;
  principal_id : principal;
  profile_stats : UserProfileGlobalStats;
  followers_count : nat64;
  caller_follows_user : opt bool;
};
type UserProfileDetailsForFrontendV5 = record {
  bio : opt text;
  website_url : opt text;
  following_count : nat64;
  user_follows_caller : opt bool;
  profile_picture_url : opt text;
  subscription_plan : SubscriptionPlan;
  principal_id : principal;
  followers_count : nat64;
  caller_follows_user : opt bool;
};
type UserProfileDetailsForFrontendV6 = record {
  bio : opt text;
  website_url : opt text;
  is_ai_influencer : bool;
  profile_picture : opt ProfilePictureData;
  following_count : nat64;
  user_follows_caller : opt bool;
  subscription_plan : SubscriptionPlan;
  principal_id : principal;
  followers_count : nat64;
  caller_follows_user : opt bool;
};
type UserProfileDetailsForFrontendV7 = record {
  bio : opt text;
  website_url : opt text;
  is_ai_influencer : bool;
  profile_picture : opt ProfilePictureData;
  following_count : nat64;
  user_follows_caller : opt bool;
  subscription_plan : SubscriptionPlan;
  principal_id : principal;
  followers_count : nat64;
  caller_follows_user : opt bool;
  account_type : UserAccountType;
};
type UserProfileGlobalStats = record {
  hot_bets_received : nat64;
  not_bets_received : nat64;
};
type YralProSubscription = record {
  free_video_credits_left : nat32;
  total_video_credits_alloted : nat32;
};
service : (UserInfoServiceInitArgs) -> {
  accept_new_user_registration : (principal, bool) -> (Result);
  accept_new_user_registration_v2 : (principal, bool, opt principal) -> (
      Result,
    );
  add_pro_plan_free_video_credits : (principal, nat32) -> (Result);
  change_subscription_plan : (principal, SubscriptionPlan) -> (Result);
  convert_to_bot_account : (principal, principal) -> (Result);
  delete_user_info : (principal) -> (Result);
  follow_user : (principal) -> (Result);
  get_followers : (principal, opt principal, nat64, opt bool) -> (
      Result_1,
    ) query;
  get_following : (principal, opt principal, nat64, opt bool) -> (
      Result_2,
    ) query;
  get_profile_details_v4 : (principal) -> (Result_3) query;
  get_user_profile_details : (principal) -> (Result_4) query;
  get_user_profile_details_v5 : (principal) -> (Result_5) query;
  get_user_profile_details_v6 : (principal) -> (Result_6) query;
  get_user_profile_details_v7 : (principal) -> (Result_7) query;
  get_user_session_type : (principal) -> (Result_8) query;
  get_users_profile_details : (vec principal) -> (Result_9) query;
  get_version : () -> (text) query;
  register_new_user : () -> (Result);
  remove_pro_plan_free_video_credits : (principal, nat32) -> (Result);
  unfollow_user : (principal) -> (Result);
  // Admin-only endpoint to update the AI influencer status for a user's profile
  update_profile_ai_influencer_status : (principal, bool) -> (Result);
  update_profile_details : (ProfileUpdateDetails) -> (Result);
  update_profile_details_v2 : (ProfileUpdateDetailsV2) -> (Result);
  update_profile_picture_nsfw_info : (principal, NSFWInfo) -> (Result);
  update_session_type : (principal, SessionType) -> (Result);
  update_user_last_access_time : (principal) -> (Result);
  // SNS validator for the generic install_code nervous system function.
  // Accepts any payload from the SNS governance canister and returns Ok so the
  // SNS can pass raw install_code arguments through without Candid type-checking.
  validate_install_code : (blob) -> (Result_10) query;
}
